# EMS Backend Environment Variables Template
# Copy this file to .env and populate with your environment credentials

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ems
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Messaging
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# SMTP Mail Service
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Resend Email Integration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=EMS System <noreply@company.com>

# Security Secrets
JWT_SECRET=
AES_ENCRYPTION_KEY=
PLATFORM_ADMIN_PASSWORD=

# Application URLs & Integration Endpoints
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ASSET_VERIFICATION_URL=http://localhost:8080/api/v1/assets/verify/
DICEBEAR_AVATAR_URL=https://api.dicebear.com/7.x/initials/svg?seed=
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=https://jira.enterprise.com

# Application Defaults
APP_SEED_DOMAIN=company.com
APP_EMAIL_SENDER_ADDRESS=noreply@company.com

# Razorpay Payment Gateway
RAZORPAY_ENABLED=true
RAZORPAY_MODE=TEST
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Logging
POST_API_LOG_FILE=post_api_payloads.log

